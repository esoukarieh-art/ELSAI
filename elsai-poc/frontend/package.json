{
  "name": "elsai-poc-frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync-docs": "node -e \"const fs=require('fs');const path=require('path');const src=path.resolve(__dirname,'..','..','docs','admin-guide.md');const dst=path.resolve(__dirname,'content','admin-guide.md');if(fs.existsSync(src)){fs.mkdirSync(path.dirname(dst),{recursive:true});fs.copyFileSync(src,dst);console.log('Synced',src,'->',dst);}else{console.warn('No source docs found at',src,'- keeping existing copy.');}\"",
    "predev": "npm run sync-docs",
    "prebuild": "npm run sync-docs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "lhci": "lhci autorun"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.5.1",
    "@sentry/nextjs": "10.56.0",
    "@tiptap/core": "^2.27.2",
    "@tiptap/extension-typography": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^3.22.4",
    "lowlight": "^3.3.0",
    "next": "16.2.7",
    "next-mdx-remote": "^6.0.0",
    "novel": "^1.0.2",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.3",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "1.60.0",
    "@tailwindcss/postcss": "4.3.0",
    "@types/node": "22.7.5",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.7",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "postcss": "8.5.15",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "0.8.0",
    "tailwindcss": "4.3.0",
    "typescript": "6.0.3"
  }
}
