{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "packages": {
    ".": {
      "release-type": "simple",
      "package-name": "elsai",
      "include-component-in-tag": false,
      "extra-files": [
        "elsai-poc/frontend/package.json",
        "elsai-poc/backend/pyproject.toml",
        "elsai-poc/backend/app/__init__.py",
        "README.md",
        { "type": "generic", "path": "VERSION" }
      ],
      "changelog-sections": [
        { "type": "feat",     "section": "✨ Nouvelles fonctionnalités" },
        { "type": "fix",      "section": "🐛 Corrections" },
        { "type": "perf",     "section": "⚡ Performances" },
        { "type": "refactor", "section": "♻️ Refactor" },
        { "type": "docs",     "section": "📝 Documentation" },
        { "type": "chore",    "section": "🔧 Maintenance", "hidden": true }
      ]
    }
  }
}
